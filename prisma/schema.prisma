model Driver {
  id                  String  @id @default(cuid())
  employeeId          String  @unique
  clientGeneratedId   String?
  talabatId           String?
  roPopsId            String?
  isRegisteredTalabat Boolean @default(false)
  isRegisteredRoPops  Boolean @default(false)
  walletBalance       Decimal @default(0) @db.Decimal(18, 3)
  targetOrders        Int     @default(370)
  assignedVehicleId   String?
  vehiclePlateNumberSnapshot String?
  fuelCardNumber      String?
  isFuelCardLinkedToVehicle Boolean @default(false)
  fuelCardLinkedVehicleId String?

  employee           Employee                    @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  assignedVehicle    Vehicle?                    @relation("DriverAssignedVehicle", fields: [assignedVehicleId], references: [id], onDelete: Restrict)
  fuelCardLinkedVehicle Vehicle?                 @relation("DriverFuelCardVehicle", fields: [fuelCardLinkedVehicleId], references: [id], onDelete: Restrict)
  dailyOrders        DeliveryDailyOrder[]
  walletTransactions DriverWalletTransaction[]
  reportLines        DeliveryMonthlyReportLine[]
  walletSettlements  DriverWalletSettlement[]
  vehicleAssignments DriverVehicleAssignment[]
  platformProfiles   DeliveryPlatformProfile[]
  absences           DeliveryAbsence[]
  evaluations        DriverEvaluation[]
  violations              DriverViolation[]
  accidents               DriverAccident[]
  vehicleIncidents        VehicleIncident[]           @relation("DriverVehicleIncidents")
  assetCustodies          AssetCustody[]
  expenses                Expense[]
  platformIdentifiers     DriverPlatformIdentifier[]
  talabatRiderMatches     TalabatReportImportRider[]  @relation("TalabatMatchedDriver")
  talabatAllocations      TalabatReportAllocation[]   @relation("TalabatAllocationDriver")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([clientGeneratedId])
  @@index([employeeId])
  @@index([assignedVehicleId])
  @@index([fuelCardLinkedVehicleId])
  @@map("drivers")
}

model Vehicle {
  id                  String      @id @default(cuid())
  companyId           String
  branchId            String?
  investorId          String?
  licenseId           String?
  assignedEmployeeId  String?
  clientGeneratedId   String?
  plateNumber         String
  vehicleNumber       String?
  ownershipModel      VehicleOwnershipType @default(OWNER_OWNED)
  make                String?
  model               String?
  year                Int?
  chassisNumber       String?
  registrationBookNumber String?
  color               String?
  type                VehicleType
  vehicleStatus       VehicleStatus @default(ACTIVE)
  isActive            Boolean     @default(true)
  trackingDeviceId    String?
  fuelCardNumber      String?
  municipalityCardNumber String?
  municipalityCardExpiryDate DateTime?
  advertisingCardNumber String?
  advertisingCardExpiryDate DateTime?
  foodLicenseNumber   String?
  foodLicenseExpiryDate DateTime?
  insuranceExpiryDate DateTime?
  insuranceExpiry     DateTime?
  registrationExpiry  DateTime?
  notes               String?

  company        Company         @relation(fields: [companyId], references: [id], onDelete: Restrict)
  branch         Branch?         @relation(fields: [branchId], references: [id], onDelete: Restrict)
  investor       Investor?       @relation(fields: [investorId], references: [id], onDelete: SetNull)
  license        License?        @relation("LicenseVehicles", fields: [licenseId], references: [id], onDelete: SetNull)
  assignedEmployee Employee?     @relation("VehicleAssignedEmployee", fields: [assignedEmployeeId], references: [id], onDelete: SetNull)
  carWashVehicle CarWashVehicle?
  assignedDrivers Driver[]       @relation("DriverAssignedVehicle")
  fuelCardDrivers Driver[]       @relation("DriverFuelCardVehicle")
  driverAssignments DriverVehicleAssignment[]
  assetCustodies       AssetCustody[]    @relation("AssetCustodyVehicle")
  expenses             Expense[]
  notifications        Notification[]
  incidents            VehicleIncident[] @relation("VehicleIncidents")
  replacementIncidents VehicleIncident[] @relation("VehicleReplacementIncidents")
  violations           DriverViolation[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([companyId, clientGeneratedId])
  @@unique([companyId, plateNumber])
  @@unique([companyId, fuelCardNumber])
  @@index([companyId])
  @@index([branchId])
  @@index([investorId])
  @@index([licenseId])
  @@index([assignedEmployeeId])
  @@index([type])
  @@index([vehicleStatus])
  @@index([registrationExpiry])
  @@index([municipalityCardExpiryDate])
  @@index([advertisingCardExpiryDate])
  @@index([foodLicenseExpiryDate])
  @@index([insuranceExpiryDate])
  @@index([insuranceExpiry])
  @@index([isActive])
  @@map("vehicles")
}

enum VehicleOwnershipType {
  OWNER_OWNED
  RENTED
}

enum VehicleType {
  DELIVERY
  CAR_WASH
  ADMIN
}

enum VehicleStatus {
  ACTIVE
  IN_MAINTENANCE
  RENTED
  SOLD
  OUT_OF_SERVICE
}

model DriverVehicleAssignment {
  id           String   @id @default(cuid())
  companyId     String
  driverId      String
  vehicleId     String
  assignedFrom  DateTime
  assignedTo    DateTime?
  isActive      Boolean  @default(true)
  notes         String?
  createdById   String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  company   Company @relation(fields: [companyId], references: [id], onDelete: Restrict)
  driver    Driver  @relation(fields: [driverId], references: [id], onDelete: Restrict)
  vehicle   Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Restrict)
  createdBy User    @relation("DriverVehicleAssignmentCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)

  @@index([companyId])
  @@index([driverId])
  @@index([vehicleId])
  @@index([isActive])
  @@index([assignedFrom])
  @@map("driver_vehicle_assignments")
}

model DeliveryContract {
  id        String           @id @default(cuid())
  companyId String
  platform  String?
  nameAr    String
  nameEn    String?
  startDate DateTime
  endDate   DateTime?
  isActive  Boolean          @default(true)
  notes     String?

  company         Company                 @relation(fields: [companyId], references: [id], onDelete: Restrict)
  monthlyReports  DeliveryMonthlyReport[]
  dailyOrders     DeliveryDailyOrder[]
  companyPayments CompanyPayment[]
  talabatImports  TalabatReportImport[]

  createdAt DateTime @default(now())

  @@index([companyId])
  @@index([isActive])
  @@map("delivery_contracts")
}


model DeliveryDailyOrder {
  id             String   @id @default(cuid())
  driverId       String
  contractId     String
  companyId      String
  date           DateTime
  ordersCount    Int      @default(0)
  ratePerOrder   Decimal? @db.Decimal(18, 3)
  grossAmount    Decimal? @db.Decimal(18, 3)
  walletDeducted Decimal? @db.Decimal(18, 3)
  rating         Decimal? @db.Decimal(5, 2)
  notes          String?

  driver   Driver           @relation(fields: [driverId], references: [id], onDelete: Restrict)
  contract DeliveryContract @relation(fields: [contractId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([driverId, contractId, date])
  @@index([driverId])
  @@index([contractId])
  @@index([companyId])
  @@index([date])
  @@map("delivery_daily_orders")
}

model DeliveryMonthlyReport {
  id                  String       @id @default(cuid())
  contractId          String
  companyId           String
  month               Int
  year                Int
  reportDate          DateTime
  totalOrdersCount    Int          @default(0)
  totalGrossAmount    Decimal      @db.Decimal(18, 3)
  totalWalletDeducted Decimal      @default(0) @db.Decimal(18, 3)
  netPayment          Decimal      @db.Decimal(18, 3)
  status              ReportStatus @default(DRAFT)
  notes               String?
  journalEntryId      String?

  contract  DeliveryContract            @relation(fields: [contractId], references: [id], onDelete: Restrict)
  lines     DeliveryMonthlyReportLine[]
  payments  CompanyPayment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([contractId, companyId, month, year])
  @@index([contractId])
  @@index([companyId])
  @@index([status])
  @@map("delivery_monthly_reports")
}

enum ReportStatus {
  DRAFT
  SUBMITTED
  POSTED
  RECONCILED
}

model DeliveryMonthlyReportLine {
  id             String  @id @default(cuid())
  reportId       String
  driverId       String
  ordersCount    Int
  ratePerOrder   Decimal @default(0) @db.Decimal(18, 3)
  grossAmount    Decimal @db.Decimal(18, 3)
  walletDeducted Decimal @default(0) @db.Decimal(18, 3)
  netAmount      Decimal @db.Decimal(18, 3)
  rating         Decimal? @db.Decimal(5, 2)
  notes          String?

  // Talabat import fields
  talabatCalculatedOrders Decimal? @db.Decimal(12, 3)
  talabatPickupPay        Decimal? @db.Decimal(12, 3)
  talabatDropoffPay       Decimal? @db.Decimal(12, 3)
  talabatTotalPayment     Decimal? @db.Decimal(12, 3)
  talabatImportId         String?
  talabatAllocationNotes  String?

  report DeliveryMonthlyReport @relation(fields: [reportId], references: [id], onDelete: Cascade)
  driver Driver                @relation(fields: [driverId], references: [id], onDelete: Restrict)

  @@index([reportId])
  @@index([driverId])
  @@map("delivery_monthly_report_lines")
}

model DriverWalletTransaction {
  id             String                @id @default(cuid())
  driverId       String
  contractId     String?
  type           WalletTransactionType
  amount         Decimal               @db.Decimal(18, 3)
  date           DateTime
  descriptionAr  String?
  journalEntryId String?
  bankAccountId  String?
  paymentMethod  String?               @default("CASH")
  isSettled      Boolean               @default(false)
  settledAt      DateTime?

  driver      Driver       @relation(fields: [driverId], references: [id], onDelete: Restrict)
  bankAccount BankAccount? @relation(fields: [bankAccountId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())

  @@index([driverId])
  @@index([isSettled])
  @@index([date])
  @@index([bankAccountId])
  @@map("driver_wallet_transactions")
}

enum WalletTransactionType {
  CHARGE
  DEPOSIT
  SETTLEMENT
  DEDUCTION
  INCENTIVE
  DEDUCTION_PENALTY
}

model DriverWalletSettlement {
  id             String  @id @default(cuid())
  driverId       String
  reportId       String
  amount         Decimal @db.Decimal(18, 3)
  date           DateTime
  journalEntryId String?

  driver Driver @relation(fields: [driverId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())

  @@index([driverId])
  @@index([reportId])
  @@index([date])
  @@map("driver_wallet_settlements")
}

model CompanyPayment {
  id               String           @id @default(cuid())
  companyId        String
  contractId       String?
  reportId         String?
  platform         String?
  month            Int
  year             Int
  grossAmount      Decimal          @db.Decimal(18, 3)
  walletDeductions Decimal          @default(0) @db.Decimal(18, 3)
  netReceived      Decimal          @db.Decimal(18, 3)
  receivedDate     DateTime
  bankAccountId    String?
  journalEntryId   String?
  notes            String?
  status           String           @default("RECEIVED")

  contract    DeliveryContract?      @relation(fields: [contractId], references: [id], onDelete: Restrict)
  report      DeliveryMonthlyReport? @relation(fields: [reportId], references: [id], onDelete: Restrict)
  bankAccount BankAccount?           @relation(fields: [bankAccountId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())

  @@index([companyId])
  @@index([contractId])
  @@index([reportId])
  @@index([bankAccountId])
  @@index([status])
  @@index([receivedDate])
  @@map("company_payments")
}

