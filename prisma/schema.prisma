generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ═══════════════════════════════════════════════════════════
// AUTH & RBAC
// ═══════════════════════════════════════════════════════════

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  nameAr       String
  nameEn       String?
  passwordHash String
  phone        String?
  isActive     Boolean  @default(true)
  isSuperAdmin Boolean  @default(false)

  roles         UserRole[]
  groupAccess   UserGroupAccess[]
  companyAccess UserCompanyAccess[]
  branchAccess  UserBranchAccess[]
  auditLogs     AuditLog[]
  uploadedAttachments Attachment[] @relation("AttachmentUploadedBy")
  createdDriverVehicleAssignments DriverVehicleAssignment[] @relation("DriverVehicleAssignmentCreatedBy")
  assignedAssetCustodies AssetCustody[] @relation("AssetCustodyAssignedBy")
  returnedAssetCustodies AssetCustody[] @relation("AssetCustodyReturnedBy")
  createdJournalEntries  JournalEntry[] @relation("JournalCreatedBy")
  approvedJournalEntries JournalEntry[] @relation("JournalApprovedBy")
  vehicleIncidents       VehicleIncident[] @relation("VehicleIncidentCreatedBy")
  completedTasks         CompletedTask[]
  reminders              Reminder[]
  pushSubscriptions      PushSubscription[]
  directPermissions      UserPermission[] @relation("UserDirectPermissions")
  grantedPermissions     UserPermission[] @relation("UserPermissionGrantedBy")
  createdTalabatImports  TalabatReportImport[]     @relation("TalabatImportCreatedBy")
  talabatAllocations     TalabatReportAllocation[] @relation("TalabatAllocationCreatedBy")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("users")
}

model Role {
  id          String  @id @default(cuid())
  name        String  @unique
  nameAr      String
  description String?

  permissions RolePermission[]
  users       UserRole[]
  companyAccessAssignments UserCompanyAccess[]

  createdAt DateTime @default(now())

  @@map("roles")
}

model Permission {
  id       String          @id @default(cuid())
  module   String
  action   String
  scope    PermissionScope @default(COMPANY)
  resource String          @default("GENERAL")

  roles           RolePermission[]
  userPermissions UserPermission[]

  @@unique([module, action, scope])
  @@map("permissions")
}

enum PermissionScope {
  GROUP
  COMPANY
  BRANCH
  OWN
}

model RolePermission {
  roleId       String
  permissionId String

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model UserPermission {
  id           String   @id @default(cuid())
  userId       String
  permissionId String
  scopeKey     String
  companyId    String?
  branchId     String?
  isAllowed    Boolean  @default(true)
  grantedById  String?

  user       User       @relation("UserDirectPermissions", fields: [userId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  company    Company?   @relation(fields: [companyId], references: [id], onDelete: SetNull)
  branch     Branch?    @relation(fields: [branchId], references: [id], onDelete: SetNull)
  grantedBy  User?      @relation("UserPermissionGrantedBy", fields: [grantedById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, permissionId, scopeKey])
  @@index([userId])
  @@index([permissionId])
  @@index([companyId])
  @@index([branchId])
  @@index([grantedById])
  @@map("user_permissions")
}

model UserRole {
  id        String  @id @default(cuid())
  userId    String
  roleId    String
  companyId String?

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role    Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)
  company Company? @relation(fields: [companyId], references: [id], onDelete: Restrict)

  // MySQL: NULL != NULL in unique indexes, so multiple NULL companyId rows are allowed.
  // The seed uses findFirst + create instead of upsert for the NULL case.
  @@unique([userId, roleId, companyId])
  @@index([userId])
  @@index([companyId])
  @@map("user_roles")
}

model UserGroupAccess {
  id         String   @id @default(cuid())
  userId     String
  groupId    String
  canView    Boolean  @default(true)
  canCreate  Boolean  @default(false)
  canUpdate  Boolean  @default(false)
  canDelete  Boolean  @default(false)
  canApprove Boolean  @default(false)

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  group Group @relation(fields: [groupId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, groupId])
  @@index([userId])
  @@index([groupId])
  @@map("user_group_access")
}

model UserCompanyAccess {
  id         String   @id @default(cuid())
  userId    String
  companyId String
  roleId    String?
  canView    Boolean  @default(true)
  canCreate  Boolean  @default(false)
  canUpdate  Boolean  @default(false)
  canDelete  Boolean  @default(false)
  canApprove Boolean  @default(false)

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  company  Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  role     Role?    @relation(fields: [roleId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, companyId])
  @@index([userId])
  @@index([companyId])
  @@map("user_company_access")
}

model UserBranchAccess {
  id         String   @id @default(cuid())
  userId     String
  branchId   String
  companyId  String
  canView    Boolean  @default(true)
  canCreate  Boolean  @default(false)
  canUpdate  Boolean  @default(false)
  canDelete  Boolean  @default(false)
  canApprove Boolean  @default(false)

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  branch   Branch   @relation(fields: [branchId], references: [id], onDelete: Cascade)
  company  Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, branchId])
  @@index([userId])
  @@index([branchId])
  @@index([companyId])
  @@map("user_branch_access")
}

// ═══════════════════════════════════════════════════════════
// GROUP & COMPANIES
// ═══════════════════════════════════════════════════════════

model Group {
  id        String    @id @default(cuid())
  nameAr    String
  nameEn    String?
  address   String?
  phone     String?
  email     String?
  logoUrl   String?
  companies Company[]
  userAccess UserGroupAccess[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("groups")
}

model Company {
  id             String      @id @default(cuid())
  groupId        String
  nameAr         String
  nameEn         String?
  type           CompanyType
  ownershipType  OwnershipType @default(OWNER_COMPANY)
  investorId     String?
  parentCompanyId String?
  unifiedEntityNumber String?
  mainLicenseNumber String?
  isMainLicenseEntity Boolean @default(true)
  commercialReg  String?
  taxNumber      String?
  address        String?
  phone          String?
  email          String?
  logoUrl        String?
  isActive       Boolean     @default(true)
  sortOrder      Int         @default(0)

  group             Group               @relation(fields: [groupId], references: [id])
  investor          Investor?           @relation("InvestorOwnedCompanies", fields: [investorId], references: [id], onDelete: SetNull)
  parentCompany     Company?            @relation("CompanyHierarchy", fields: [parentCompanyId], references: [id], onDelete: SetNull)
  childCompanies    Company[]           @relation("CompanyHierarchy")
  branches          Branch[]
  bankAccounts      BankAccount[]
  fiscalYears       FiscalYear[]
  chartOfAccounts   ChartOfAccount[]
  costCenters       CostCenter[]
  journalEntries    JournalEntry[]
  employees         Employee[]
  vehicles          Vehicle[]
  deliveryPlatformProfiles DeliveryPlatformProfile[]
  deliveryAbsences  DeliveryAbsence[]
  driverEvaluations DriverEvaluation[]
  driverViolations  DriverViolation[]
  driverAccidents     DriverAccident[]
  vehicleIncidents    VehicleIncident[]
  deliveryContracts   DeliveryContract[]
  talabatImports      TalabatReportImport[]
  carWashVehicles   CarWashVehicle[]
  carWashWorkers    CarWashWorker[]
  carWashLocations  CarWashLocation[]
  investors         Investor[]          @relation("CompanyInvestors")
  expenseCategories   ExpenseCategory[]
  expenses            Expense[]
  salaryBatches       SalaryBatch[]
  employeePositions   EmployeePosition[]
  endOfServiceCalcs   EndOfServiceCalc[]
  leavePayCalcs       LeavePayCalc[]
  licenses            License[]
  notifications     Notification[]
  completedTasks    CompletedTask[]
  userPermissions   UserPermission[]
  userAccess        UserCompanyAccess[]
  branchAccesses    UserBranchAccess[]
  userRoles         UserRole[]
  attachments       Attachment[]
  assetItemTypes    AssetItemType[]
  assetItems        AssetItem[]
  assetCustodies    AssetCustody[]
  driverVehicleAssignments DriverVehicleAssignment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([groupId])
  @@index([ownershipType])
  @@index([investorId])
  @@index([parentCompanyId])
  @@index([unifiedEntityNumber])
  @@map("companies")
}

enum CompanyType {
  DELIVERY
  CAR_WASH
  GENERAL_TRADING
  TRADING
  HOLDING
  OTHER
}

enum OwnershipType {
  OWNER_COMPANY
  INVESTOR_COMPANY
  OWNER_BRANCH
  INVESTOR_BRANCH
}

model Branch {
  id        String  @id @default(cuid())
  companyId String
  nameAr    String
  nameEn    String?
  ownershipType OwnershipType @default(OWNER_BRANCH)
  investorId String?
  unifiedEntityNumber String?
  mainLicenseId String?
  address   String?
  phone     String?
  isActive  Boolean @default(true)
  sortOrder Int     @default(0)

  company          Company          @relation(fields: [companyId], references: [id], onDelete: Restrict)
  investor         Investor?        @relation("InvestorOwnedBranches", fields: [investorId], references: [id], onDelete: SetNull)
  mainLicense      License?         @relation("BranchMainLicense", fields: [mainLicenseId], references: [id], onDelete: SetNull)
  employees        Employee[]
  salaryBatches    SalaryBatch[]
  claims           InvestorClaim[]
  investorBranches InvestorBranch[]
  investorAccountAgreements InvestorAccountAgreement[]
  investorSalaryFundingProfiles InvestorSalaryFundingProfile[]
  userAccess       UserBranchAccess[]
  deliveryPlatformProfiles DeliveryPlatformProfile[]
  deliveryAbsences DeliveryAbsence[]
  driverEvaluations DriverEvaluation[]
  driverViolations DriverViolation[]
  driverAccidents DriverAccident[]
  expenses         Expense[]
  vehicles         Vehicle[]
  carWashVehicles  CarWashVehicle[]
  carWashWorkers   CarWashWorker[]
  attachments      Attachment[]
  assetItems       AssetItem[]
  assetCustodies   AssetCustody[]
  licenses         License[]
  notifications    Notification[]
  completedTasks   CompletedTask[]
  userPermissions  UserPermission[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId])
  @@index([ownershipType])
  @@index([investorId])
  @@index([unifiedEntityNumber])
  @@index([mainLicenseId])
  @@map("branches")
}

model BankAccount {
  id             String  @id @default(cuid())
  companyId      String
  nameAr         String
  nameEn         String?
  bankName       String
  accountNumber  String
  iban           String?
  currency       String  @default("KWD")
  isActive       Boolean @default(true)
  isDefault      Boolean @default(false)
  chartAccountId String?

  company         Company         @relation(fields: [companyId], references: [id], onDelete: Restrict)
  chartAccount    ChartOfAccount? @relation(fields: [chartAccountId], references: [id], onDelete: Restrict)
  knetSettlements KnetSettlement[]
  companyPayments CompanyPayment[]
  expenses        Expense[]
  sourceTransfers AccountTransfer[]      @relation("TransferSourceBankAccount")
  destinationTransfers AccountTransfer[] @relation("TransferDestinationBankAccount")
  driverWalletTransactions DriverWalletTransaction[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId])
  @@index([chartAccountId])
  @@map("bank_accounts")
}

model FiscalYear {
  id        String   @id @default(cuid())
  companyId String
  year      Int
  startDate DateTime
  endDate   DateTime
  isLocked  Boolean  @default(false)
  isCurrent Boolean  @default(false)

  company         Company          @relation(fields: [companyId], references: [id], onDelete: Restrict)
  journalEntries  JournalEntry[]
  openingBalances OpeningBalance[]

  createdAt DateTime @default(now())

  @@unique([companyId, year])
  @@index([companyId])
  @@map("fiscal_years")
}

// ═══════════════════════════════════════════════════════════
// CHART OF ACCOUNTS
// ═══════════════════════════════════════════════════════════

model ChartOfAccount {
  id            String       @id @default(cuid())
  companyId     String
  code          String
  nameAr        String
  nameEn        String?
  type          AccountType
  subtype       String?
  parentId      String?
  level         Int          @default(1)
  isHeader      Boolean      @default(false)
  isActive      Boolean      @default(true)
  normalBalance NormalBalance @default(DEBIT)
  notes         String?

  company         Company           @relation(fields: [companyId], references: [id], onDelete: Restrict)
  parent          ChartOfAccount?   @relation("AccountHierarchy", fields: [parentId], references: [id], onDelete: Restrict)
  children        ChartOfAccount[]  @relation("AccountHierarchy")
  journalLines    JournalEntryLine[]
  bankAccounts    BankAccount[]
  openingBalances OpeningBalance[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([companyId, code])
  @@index([companyId])
  @@index([parentId])
  @@index([type])
  @@index([isActive])
  @@map("chart_of_accounts")
}

enum AccountType {
  ASSET
  LIABILITY
  EQUITY
  REVENUE
  EXPENSE
}

enum NormalBalance {
  DEBIT
  CREDIT
}

model OpeningBalance {
  id           String  @id @default(cuid())
  accountId    String
  fiscalYearId String
  debit        Decimal @default(0) @db.Decimal(18, 3)
  credit       Decimal @default(0) @db.Decimal(18, 3)

  account    ChartOfAccount @relation(fields: [accountId], references: [id], onDelete: Restrict)
  fiscalYear FiscalYear     @relation(fields: [fiscalYearId], references: [id], onDelete: Restrict)

  @@unique([accountId, fiscalYearId])
  @@index([accountId])
  @@index([fiscalYearId])
  @@map("opening_balances")
}

// ═══════════════════════════════════════════════════════════
// JOURNAL ENTRIES — Core Double-Entry Accounting
// ═══════════════════════════════════════════════════════════

model JournalEntry {
  id            String           @id @default(cuid())
  companyId     String
  fiscalYearId  String
  number        String
  date          DateTime
  descriptionAr String
  descriptionEn String?
  type          JournalEntryType
  status        JournalStatus    @default(DRAFT)
  reference     String?
  refModule     String?
  refId         String?
  isAutomatic   Boolean          @default(false)
  costCenterId  String?
  totalDebit    Decimal          @default(0) @db.Decimal(18, 3)
  totalCredit   Decimal          @default(0) @db.Decimal(18, 3)
  isDeleted     Boolean          @default(false)
  deletedAt     DateTime?

  // Reversal tracking fields
  isReversed      Boolean   @default(false)
  reversedAt      DateTime?
  reversedBy      String?
  reversalEntryId String?

  approvedById String?
  approvedAt   DateTime?
  postedById   String?
  postedAt     DateTime?
  createdById  String

  company    Company      @relation(fields: [companyId], references: [id], onDelete: Restrict)
  fiscalYear FiscalYear   @relation(fields: [fiscalYearId], references: [id], onDelete: Restrict)
  costCenter CostCenter?  @relation(fields: [costCenterId], references: [id], onDelete: Restrict)
  createdBy  User         @relation("JournalCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  approvedBy User?        @relation("JournalApprovedBy", fields: [approvedById], references: [id], onDelete: Restrict)
  lines      JournalEntryLine[]
  attachments Attachment[]
  auditLogs  AuditLog[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([companyId, number])
  @@index([companyId])
  @@index([fiscalYearId])
  @@index([costCenterId])
  @@index([status])
  @@index([date])
  @@index([type])
  @@index([refModule, refId])
  @@index([isDeleted])
  @@index([isReversed])
  @@index([reversalEntryId])
  @@index([createdAt])
  @@map("journal_entries")
}

enum JournalEntryType {
  GENERAL
  RECEIPT
  PAYMENT
  TRANSFER
  SALARY
  OPENING_BALANCE
  DEPRECIATION
  ADJUSTMENT
  DELIVERY_INCOME
  DELIVERY_WALLET
  CAR_WASH_REVENUE
  KNET_SETTLEMENT
  INVESTOR_COLLECTION
  INVESTOR_SALARY_COLLECTION
  INVESTOR_SALARY_DISBURSEMENT
  EXPENSE
  REVERSAL
}

enum JournalStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  POSTED
  REJECTED
  CANCELLED
}

model JournalEntryLine {
  id             String  @id @default(cuid())
  journalEntryId String
  accountId      String
  descriptionAr  String?
  descriptionEn  String?
  debit          Decimal @default(0) @db.Decimal(18, 3)
  credit         Decimal @default(0) @db.Decimal(18, 3)
  sortOrder      Int     @default(0)

  costCenterId     String?
  driverId         String?
  employeeId       String?
  investorId       String?
  branchId         String?
  carWashVehicleId String?

  journalEntry JournalEntry   @relation(fields: [journalEntryId], references: [id], onDelete: Cascade)
  account      ChartOfAccount @relation(fields: [accountId], references: [id], onDelete: Restrict)
  costCenter   CostCenter?    @relation(fields: [costCenterId], references: [id], onDelete: Restrict)

  @@index([journalEntryId])
  @@index([accountId])
  @@index([costCenterId])
  @@index([driverId])
  @@index([employeeId])
  @@index([investorId])
  @@index([branchId])
  @@map("journal_entry_lines")
}

model CostCenter {
  id        String  @id @default(cuid())
  companyId String
  code      String
  nameAr    String
  nameEn    String?
  type      String
  isActive  Boolean @default(true)

  company        Company            @relation(fields: [companyId], references: [id], onDelete: Restrict)
  journalEntries JournalEntry[]
  journalLines   JournalEntryLine[]
  carWashVehicle CarWashVehicle?
  expenses       Expense[]

  @@unique([companyId, code])
  @@index([companyId])
  @@map("cost_centers")
}

// ═══════════════════════════════════════════════════════════
// ATTACHMENTS & AUDIT
// ═══════════════════════════════════════════════════════════

model Attachment {
  id             String  @id @default(cuid())
  companyId      String?
  branchId       String?
  entityType     String?
  entityId       String?
  attachmentType String?
  fileName       String
  originalName   String
  fileType       String
  fileSize       Int
  filePath       String
  refModule      String
  refId          String
  uploadedById   String
  journalEntryId String?
  mimeType       String?
  storagePath    String?
  notes          String?
  documentCategory String?
  languageCode   String?
  clientGeneratedId String?
  deletedAt      DateTime?

  company      Company?       @relation(fields: [companyId], references: [id], onDelete: Restrict)
  branch       Branch?        @relation(fields: [branchId], references: [id], onDelete: Restrict)
  uploadedBy   User           @relation("AttachmentUploadedBy", fields: [uploadedById], references: [id], onDelete: Restrict)
  journalEntry JournalEntry? @relation(fields: [journalEntryId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([companyId])
  @@index([branchId])
  @@index([journalEntryId])
  @@index([entityType, entityId])
  @@index([attachmentType])
  @@index([deletedAt])
  @@index([refModule, refId])
  @@map("attachments")
}

model AuditLog {
  id             String  @id @default(cuid())
  userId         String
  action         String
  module         String
  resourceId     String
  resourceType   String
  oldValues      Json?
  newValues      Json?
  ipAddress      String?
  companyId      String?
  branchId       String?
  userAgent      String?
  journalEntryId String?

  user         User          @relation(fields: [userId], references: [id], onDelete: Restrict)
  journalEntry JournalEntry? @relation(fields: [journalEntryId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([companyId])
  @@index([branchId])
  @@index([journalEntryId])
  @@index([module, resourceType])
  @@index([createdAt])
  @@map("audit_logs")
}

enum CompletedTaskStatus {
  COMPLETED
  NOT_COMPLETED
  DEFERRED
}

model CompletedTask {
  id             String              @id @default(cuid())
  userId         String
  companyId      String?
  branchId       String?
  titleAr        String
  titleEn        String?
  detailsAr      String?
  detailsEn      String?
  taskDate       DateTime
  departedAt     DateTime?
  returnedAt     DateTime?
  status         CompletedTaskStatus @default(COMPLETED)
  deferredToDate DateTime?
  outcomeNotes   String?
  location       String?

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  company Company? @relation(fields: [companyId], references: [id], onDelete: SetNull)
  branch  Branch?  @relation(fields: [branchId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, taskDate])
  @@index([companyId])
  @@index([branchId])
  @@index([status])
  @@index([deferredToDate])
  @@index([createdAt])
  @@map("completed_tasks")
}

// ═══════════════════════════════════════════════════════════
// HR MODULE
// ═══════════════════════════════════════════════════════════

model Employee {
  id                 String       @id @default(cuid())
  companyId          String
  branchId           String?
  investorId         String?
  licenseId          String?
  clientGeneratedId  String?
  employeeNumber     String?
  nameAr             String
  nameEn             String?
  type               EmployeeType
  nationality        String?
  dateOfBirth        DateTime?
  civilId            String?
  passportNumber     String?
  passportIssueDate  DateTime?
  passportExpiryDate DateTime?
  residencyNumber    String?
  residencyExpiry    DateTime?
  ministryOfInteriorReferenceNumber String?
  healthCardExpiryDate DateTime?
  municipalityCardExpiryDate DateTime?
  visaNumber         String?
  visaExpiryDate     DateTime?
  residencyAlertDays Int          @default(60)
  licenseNumber      String?
  licenseExpiry      DateTime?
  jobTitle           String?
  residentialAddress String?
  employmentStatus   EmploymentStatus @default(ACTIVE)
  phone              String?
  joinDate           DateTime?
  endDate            DateTime?
  baseSalary         Decimal?     @db.Decimal(18, 3)
  actualSalary       Decimal?     @db.Decimal(18, 3)
  bankAccountNumber  String?
  passportCustodyStatus PassportCustodyStatus @default(WITH_DRIVER)
  passportReceivedDate DateTime?
  passportReleasedDate DateTime?
  passportReleaseNotes String?
  notes              String?
  isActive           Boolean      @default(true)
  isDeleted          Boolean      @default(false)
  deletedAt          DateTime?

  positionId     String?

  company        Company           @relation(fields: [companyId], references: [id], onDelete: Restrict)
  branch         Branch?           @relation(fields: [branchId], references: [id], onDelete: Restrict)
  investor       Investor?         @relation(fields: [investorId], references: [id], onDelete: SetNull)
  license        License?          @relation(fields: [licenseId], references: [id], onDelete: SetNull)
  position       EmployeePosition? @relation(fields: [positionId], references: [id], onDelete: Restrict)
  driver         Driver?
  carWashWorker  CarWashWorker?
  assetCustodies AssetCustody[]
  expenses       Expense[]
  salaryPayments SalaryPayment[]
  salaryItems    SalaryItem[]
  tickets        EmployeeTicket[]
  endOfServiceCalcs EndOfServiceCalc[]
  leavePayCalcs     LeavePayCalc[]
  assignedVehicles    Vehicle[]                    @relation("VehicleAssignedEmployee")
  notifications       Notification[]
  licenseAssignments     EmployeeLicenseAssignment[]
  claimBeneficiaries     InvestorClaimBeneficiary[]
  investorAccountAgreements InvestorAccountAgreement[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([companyId, clientGeneratedId])
  @@unique([companyId, civilId])
  @@index([companyId])
  @@index([branchId])
  @@index([investorId])
  @@index([licenseId])
