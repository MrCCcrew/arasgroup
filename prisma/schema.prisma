  isActive             Boolean @default(true)

  company Company @relation(fields: [companyId], references: [id], onDelete: Restrict)
  branch  Branch? @relation(fields: [branchId], references: [id], onDelete: SetNull)
  driver  Driver  @relation(fields: [driverId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId])
  @@index([branchId])
  @@index([driverId])
  @@index([platformName])
  @@map("delivery_platform_profiles")
}

model DeliveryAbsence {
  id          String @id @default(cuid())
  companyId   String
  branchId    String?
  driverId    String
  date        DateTime
  reason      String?
  isPaid      Boolean @default(false)
  notes       String?

  company Company @relation(fields: [companyId], references: [id], onDelete: Restrict)
  branch  Branch? @relation(fields: [branchId], references: [id], onDelete: SetNull)
  driver  Driver  @relation(fields: [driverId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([driverId, date])
  @@index([companyId])
  @@index([branchId])
  @@index([date])
  @@map("delivery_absences")
}

model DriverEvaluation {
  id         String @id @default(cuid())
  companyId  String
  branchId   String?
  driverId   String
  month      Int
  year       Int
  score      Decimal @db.Decimal(10, 3)
  notes      String?

  company Company @relation(fields: [companyId], references: [id], onDelete: Restrict)
  branch  Branch? @relation(fields: [branchId], references: [id], onDelete: SetNull)
  driver  Driver  @relation(fields: [driverId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([driverId, month, year])
  @@index([companyId])
  @@index([branchId])
  @@map("driver_evaluations")
}

model DriverViolation {
  id                 String @id @default(cuid())
  companyId          String
  branchId           String?
  driverId           String
  vehicleId          String?

  date               DateTime
  locationAr         String?
  locationEn         String?
  type               String
  descriptionAr      String?
  descriptionEn      String?

  amount             Decimal @db.Decimal(18, 3)

  // who pays: DRIVER | COMPANY | SPLIT
  responsibility     String  @default("DRIVER")
  driverSharePct     Int?

  // how driver pays: FULL | INSTALLMENT
  paymentMode        String  @default("FULL")
  installmentMonths  Int?
  installmentsPaid   Int     @default(0)

  status             String  @default("PENDING")

  // legacy field kept for backward compat
  driverPays         Boolean @default(true)

  // auto-created expense for company portion
  expenseId          String? @unique

  notes              String?

  company  Company  @relation(fields: [companyId], references: [id], onDelete: Restrict)
  branch   Branch?  @relation(fields: [branchId], references: [id], onDelete: SetNull)
  driver   Driver   @relation(fields: [driverId], references: [id], onDelete: Cascade)
  vehicle  Vehicle? @relation(fields: [vehicleId], references: [id], onDelete: SetNull)
  expense  Expense? @relation(fields: [expenseId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId])
  @@index([branchId])
  @@index([driverId])
  @@index([vehicleId])
  @@index([date])
  @@index([status])
  @@map("driver_violations")
}

model DriverAccident {
  id                 String @id @default(cuid())
  companyId          String
  branchId           String?
  driverId           String
  date               DateTime
  descriptionAr      String
  descriptionEn      String?
  causedByDriver     Boolean @default(false)
  repairAmount       Decimal? @db.Decimal(18, 3)
  paymentMode        String?
  installmentMonths  Int?
  notes              String?

  company Company @relation(fields: [companyId], references: [id], onDelete: Restrict)
  branch  Branch? @relation(fields: [branchId], references: [id], onDelete: SetNull)
  driver  Driver  @relation(fields: [driverId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId])
  @@index([branchId])
  @@index([driverId])
  @@index([date])
  @@map("driver_accidents")
}

// ─── Vehicle Incident & Replacement Tracking ───────────────────────────────

enum IncidentType {
  ACCIDENT
  BREAKDOWN
}

enum ReplacementSource {
  RENTAL_COMPANY
  OWN_FLEET
}

enum IncidentStatus {
  OPEN
  IN_REPAIR
  RESOLVED
}

model VehicleIncident {
  id                      String             @id @default(cuid())
  companyId               String
  driverId                String
  vehicleId               String

  incidentDate            DateTime
  incidentType            IncidentType
  descriptionAr           String?
  descriptionEn           String?

  // Replacement vehicle
  replacementSource       ReplacementSource?
  replacementVehicleId    String?            // own-fleet replacement (links to Vehicle)
  replacementVehiclePlate String?            // rental-company replacement plate (free text)
  replacementStartDate    DateTime?
  replacementEndDate      DateTime?
  replacementNotes        String?

  // Repair / garage
  garageNameAr            String?
  garagePhone             String?
  repairStartDate         DateTime?
  repairEndDate           DateTime?
  repairCost              Decimal?           @db.Decimal(18, 3)

  status                  IncidentStatus     @default(OPEN)
  resolvedDate            DateTime?
  notes                   String?
  createdById             String?

  company            Company   @relation(fields: [companyId], references: [id], onDelete: Restrict)
  driver             Driver    @relation("DriverVehicleIncidents", fields: [driverId], references: [id], onDelete: Restrict)
  vehicle            Vehicle   @relation("VehicleIncidents", fields: [vehicleId], references: [id], onDelete: Restrict)
  replacementVehicle Vehicle?  @relation("VehicleReplacementIncidents", fields: [replacementVehicleId], references: [id], onDelete: SetNull)
  createdBy          User?     @relation("VehicleIncidentCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId])
  @@index([driverId])
  @@index([vehicleId])
  @@index([status])
  @@index([incidentDate])
  @@map("vehicle_incidents")
}

model AccountTransfer {
  id                    String @id @default(cuid())
  sourceBankAccountId   String
  destinationBankAccountId String
  companyId             String?
  branchId              String?
  investorId            String?
  amount                Decimal @db.Decimal(18, 3)
  transferDate          DateTime
  purposeAr             String
  purposeEn             String?
  reference             String?
  journalEntryId        String?
  createdById           String?
  notes                 String?

  sourceBankAccount      BankAccount @relation("TransferSourceBankAccount", fields: [sourceBankAccountId], references: [id], onDelete: Restrict)
  destinationBankAccount BankAccount @relation("TransferDestinationBankAccount", fields: [destinationBankAccountId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([sourceBankAccountId])
  @@index([destinationBankAccountId])
  @@index([companyId])
  @@index([branchId])
  @@index([investorId])
  @@index([transferDate])
  @@map("account_transfers")
}

// ═══════════════════════════════════════════════════════════
// EXPENSES MODULE
// ═══════════════════════════════════════════════════════════

model ExpenseCategory {
  id        String  @id @default(cuid())
  companyId String
  nameAr    String
  nameEn    String?
  code      String?
  type      String
  parentId  String?
  isActive  Boolean @default(true)

  company           Company           @relation(fields: [companyId], references: [id], onDelete: Restrict)
  parent            ExpenseCategory?  @relation("CategoryHierarchy", fields: [parentId], references: [id], onDelete: Restrict)
  children          ExpenseCategory[] @relation("CategoryHierarchy")
  expenses          Expense[]
  recurringExpenses RecurringExpense[]

  @@unique([companyId, nameAr])
  @@index([companyId])
  @@index([parentId])
  @@map("expense_categories")
}

model Expense {
  id            String   @id @default(cuid())
  companyId     String
  categoryId    String
  date          DateTime
  amount        Decimal  @db.Decimal(18, 3)
  descriptionAr String
  descriptionEn String?
  paymentMethod String   @default("CASH")
  bankAccountId String?
  reference     String?
  isRecurring   Boolean  @default(false)
  recurringId   String?

  branchId         String?
  driverId         String?
  employeeId       String?
  vehicleId        String?
  investorId       String?
  costCenterId     String?
  carWashVehicleId String?

  journalEntryId String?
  status         String  @default("POSTED")
  isDeleted      Boolean @default(false)

  company         Company          @relation(fields: [companyId], references: [id], onDelete: Restrict)
  category        ExpenseCategory  @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  bankAccount     BankAccount?     @relation(fields: [bankAccountId], references: [id], onDelete: Restrict)
  branch          Branch?          @relation(fields: [branchId], references: [id], onDelete: Restrict)
  employee        Employee?        @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  driver          Driver?          @relation(fields: [driverId], references: [id], onDelete: Restrict)
  vehicle         Vehicle?         @relation(fields: [vehicleId], references: [id], onDelete: Restrict)
  investor        Investor?        @relation(fields: [investorId], references: [id], onDelete: Restrict)
  costCenter      CostCenter?      @relation(fields: [costCenterId], references: [id], onDelete: Restrict)
  carWashVehicle  CarWashVehicle?  @relation(fields: [carWashVehicleId], references: [id], onDelete: Restrict)
  violation       DriverViolation?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId])
  @@index([categoryId])
  @@index([date])
  @@index([branchId])
  @@index([driverId])
  @@index([employeeId])
  @@index([vehicleId])
  @@index([investorId])
  @@index([costCenterId])
  @@index([status])
  @@index([isDeleted])
  @@map("expenses")
}

model RecurringExpense {
  id            String    @id @default(cuid())
  companyId     String
  categoryId    String
  descriptionAr String
  amount        Decimal   @db.Decimal(18, 3)
  frequency     String
  dayOfMonth    Int?
  startDate     DateTime
  endDate       DateTime?
  isActive      Boolean   @default(true)
  lastGenerated DateTime?
  nextDueDate   DateTime?

  category ExpenseCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())

  @@index([companyId])
  @@index([categoryId])
  @@index([isActive])
  @@map("recurring_expenses")
}

// ═══════════════════════════════════════════════════════════
// NOTIFICATIONS & SYNC
// ═══════════════════════════════════════════════════════════

model Notification {
  id           String @id @default(cuid())
  userId       String?
  companyId    String?
  branchId     String?
  investorId   String?
  employeeId   String?
  licenseId    String?
  vehicleId    String?
  entityType   String?
  entityId     String?
  type         String
  titleAr      String
  titleEn      String?
  messageAr    String?
  messageEn    String?
  dueDate      DateTime?
  severity     String  @default("INFO")
  status       String  @default("UNREAD")
  uniqueKey    String  @unique
  targetRole   String?
  targetUserId String?
  refModule    String?
  refId        String?
  readAt       DateTime?
  resolvedAt   DateTime?

  company  Company?  @relation(fields: [companyId], references: [id], onDelete: Restrict)
  branch   Branch?   @relation(fields: [branchId], references: [id], onDelete: SetNull)
  investor Investor? @relation(fields: [investorId], references: [id], onDelete: SetNull)
  employee Employee? @relation(fields: [employeeId], references: [id], onDelete: SetNull)
  license  License?  @relation(fields: [licenseId], references: [id], onDelete: SetNull)
  vehicle  Vehicle?  @relation(fields: [vehicleId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([companyId])
  @@index([branchId])
  @@index([investorId])
  @@index([employeeId])
  @@index([licenseId])
  @@index([vehicleId])
  @@index([status])
  @@index([targetRole])
  @@index([targetUserId])
  @@index([dueDate])
  @@index([createdAt])
  @@map("notifications")
}

model SyncQueue {
  id              String     @id @default(cuid())
  clientId        String
  deviceId        String
  userId          String
  companyId       String
  operation       String
  module          String
  entityType      String
  entityId        String?
  payload         Json
  status          SyncStatus @default(PENDING)
  retryCount      Int        @default(0)
  error           String?
  clientTimestamp DateTime
  syncedAt        DateTime?

  createdAt DateTime @default(now())

  @@index([status, companyId])
  @@index([userId])
  @@index([deviceId])
  @@index([createdAt])
  @@map("sync_queue")
}

enum SyncStatus {
  PENDING
  PROCESSING
  SYNCED
  FAILED
  CONFLICT
}

model OfflineTransaction {
  id        String    @id @default(cuid())
  clientId  String    @unique
  userId    String
  companyId String
  type      String
  data      Json
  status    String    @default("PENDING")
  syncedAt  DateTime?

  createdAt DateTime @default(now())

  @@index([status, companyId])
  @@index([userId])
  @@index([companyId])
  @@map("offline_transactions")
}

// ═══════════════════════════════════════════════════════════
// REMINDERS & PUSH NOTIFICATIONS
// ═══════════════════════════════════════════════════════════

model Reminder {
  id              String    @id @default(cuid())
  userId          String
  title           String
  notes           String?   @db.Text
  dueAt           DateTime
  reminderMinutes Int       @default(15)
  isCompleted     Boolean   @default(false)
  completedAt     DateTime?
  notifiedAt      DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([dueAt])
  @@index([isCompleted, dueAt])
  @@map("reminders")
}

model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  endpoint  String   @db.Text
  p256dh    String   @db.Text
  auth      String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("push_subscriptions")
}

// ─── Talabat Report Import ────────────────────────────────────────────────────

model DriverPlatformIdentifier {
  id               String  @id @default(cuid())
  driverId         String
  platform         String  // TALABAT | OTHER
  platformDriverId String
  isPrimary        Boolean @default(true)
  isActive         Boolean @default(true)
  notes            String?

  driver      Driver                    @relation(fields: [driverId], references: [id], onDelete: Cascade)
  allocations TalabatReportAllocation[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([platform, platformDriverId])
  @@index([driverId])
  @@index([platform, isActive])
  @@map("driver_platform_identifiers")
}

model TalabatReportImport {
  id                          String   @id @default(cuid())
  companyId                   String
  contractId                  String?
  month                       Int
  year                        Int
  fileName                    String
  originalFileUrl             String?
  status                      String   @default("DRAFT")
  orderRoundingMode           String   @default("DECIMAL_2")
  totalRows                   Int      @default(0)
  totalRiders                 Int      @default(0)
  totalPickupPay              Decimal  @default(0) @db.Decimal(12, 3)
  totalDropoffPay             Decimal  @default(0) @db.Decimal(12, 3)
  totalCalculatedOrders       Decimal  @default(0) @db.Decimal(12, 3)
  totalPayment                Decimal  @default(0) @db.Decimal(12, 3)
  contractSummaryFinalPayment Decimal? @db.Decimal(12, 3)
  notes                       String?
  createdById                 String
  postedAt                    DateTime?

  company  Company          @relation(fields: [companyId], references: [id], onDelete: Restrict)
  contract DeliveryContract? @relation(fields: [contractId], references: [id], onDelete: SetNull)
  createdBy User            @relation("TalabatImportCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  riders   TalabatReportImportRider[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId])
  @@index([companyId, month, year])
  @@index([status])
  @@map("talabat_report_imports")
}

model TalabatReportImportRider {
  id                      String  @id @default(cuid())
  importId                String
  talabatRiderId          String
  talabatRiderName        String
  contractName            String?
  companyCode             String?
  rowCount                Int     @default(0)
  totalPickupPay          Decimal @default(0) @db.Decimal(12, 3)
  totalDropoffPay         Decimal @default(0) @db.Decimal(12, 3)
  calculatedOrdersRaw     Decimal @default(0) @db.Decimal(12, 3)
  calculatedOrdersRounded Decimal @default(0) @db.Decimal(12, 3)
  totalPayment            Decimal @default(0) @db.Decimal(12, 3)
  totalDeductions         Decimal @default(0) @db.Decimal(12, 3)
  // Downgraded (Y) rows — substitute driver worked under this Rider ID
  downgradedRowCount          Int     @default(0)
  downgradedPickupPay         Decimal @default(0) @db.Decimal(12, 3)
  downgradedDropoffPay        Decimal @default(0) @db.Decimal(12, 3)
  downgradedCalculatedOrders  Decimal @default(0) @db.Decimal(12, 3)
  downgradedTotalPayment      Decimal @default(0) @db.Decimal(12, 3)
  matchingStatus          String  @default("UNMATCHED")
  matchedDriverId         String?

  import        TalabatReportImport       @relation(fields: [importId], references: [id], onDelete: Cascade)
  matchedDriver Driver?                   @relation("TalabatMatchedDriver", fields: [matchedDriverId], references: [id], onDelete: SetNull)
  allocations   TalabatReportAllocation[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([importId])
  @@index([talabatRiderId])
  @@index([matchedDriverId])
  @@map("talabat_report_import_riders")
}

model TalabatReportAllocation {
  id                   String   @id @default(cuid())
  importRiderId        String
  platformIdentifierId String?
  driverId             String
  allocationType       String   // AUTO_MATCH | MANUAL_FIXED | MANUAL_PERCENTAGE | MANUAL_REMAINING
  allocatedOrders      Decimal  @db.Decimal(12, 3)
  percentage           Decimal? @db.Decimal(6, 3)
  notes                String?
  createdById          String

  importRider          TalabatReportImportRider    @relation(fields: [importRiderId], references: [id], onDelete: Cascade)
  platformIdentifier   DriverPlatformIdentifier?   @relation(fields: [platformIdentifierId], references: [id], onDelete: SetNull)
  driver               Driver                      @relation("TalabatAllocationDriver", fields: [driverId], references: [id], onDelete: Restrict)
  createdBy            User                        @relation("TalabatAllocationCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([importRiderId])
  @@index([driverId])
  @@map("talabat_report_allocations")
}
