// CAR WASH MODULE
// ═══════════════════════════════════════════════════════════

model CarWashVehicle {
  id           String  @id @default(cuid())
  companyId    String
  branchId     String?
  clientGeneratedId String?
  vehicleId    String  @unique
  code         String
  nameAr       String
  nameEn       String?
  knetDeviceId String?
  isActive     Boolean @default(true)
  costCenterId String? @unique

  company    Company          @relation(fields: [companyId], references: [id], onDelete: Restrict)
  branch     Branch?          @relation(fields: [branchId], references: [id], onDelete: Restrict)
  vehicle    Vehicle          @relation(fields: [vehicleId], references: [id], onDelete: Restrict)
  costCenter CostCenter?      @relation(fields: [costCenterId], references: [id], onDelete: Restrict)
  workers    CarWashWorker[]
  assignedWorkers CarWashWorker[] @relation("CarWashWorkerAssignedVehicle")
  operations CarWashDailyOperation[]
  assetCustodies AssetCustody[] @relation("AssetCustodyCarWashVehicle")
  expenses       Expense[]

  createdAt DateTime @default(now())

  @@unique([companyId, clientGeneratedId])
  @@index([companyId])
  @@index([branchId])
  @@map("car_wash_vehicles")
}

model CarWashWorker {
  id         String            @id @default(cuid())
  employeeId String            @unique
  vehicleId  String?
  companyId  String?
  branchId   String?
  assignedCarWashVehicleId String?
  clientGeneratedId String?
  role       CarWashWorkerRole

  vehicle  CarWashVehicle? @relation(fields: [vehicleId], references: [id], onDelete: Restrict)
  assignedCarWashVehicle CarWashVehicle? @relation("CarWashWorkerAssignedVehicle", fields: [assignedCarWashVehicleId], references: [id], onDelete: Restrict)
  company  Company?        @relation(fields: [companyId], references: [id], onDelete: Restrict)
  branch   Branch?         @relation(fields: [branchId], references: [id], onDelete: Restrict)
  employee Employee        @relation(fields: [employeeId], references: [id], onDelete: Restrict)

  @@unique([clientGeneratedId])
  @@index([vehicleId])
  @@index([assignedCarWashVehicleId])
  @@index([companyId])
  @@index([branchId])
  @@index([employeeId])
  @@map("car_wash_workers")
}

enum CarWashWorkerRole {
  DRIVER
  WASHER
  CAR_WASH_DRIVER
  WASHING_WORKER
  SUPERVISOR
  OTHER
}

model CarWashLocation {
  id           String  @id @default(cuid())
  companyId    String
  nameAr       String
  nameEn       String?
  address      String?
  locationType String?
  isActive     Boolean @default(true)

  company    Company                 @relation(fields: [companyId], references: [id], onDelete: Restrict)
  operations CarWashDailyOperation[]

  @@index([companyId])
  @@map("car_wash_locations")
}

model CarWashDailyOperation {
  id             String  @id @default(cuid())
  vehicleId      String
  locationId     String
  companyId      String
  date           DateTime
  totalCash      Decimal @default(0) @db.Decimal(18, 3)
  totalKnet      Decimal @default(0) @db.Decimal(18, 3)
  totalExpenses  Decimal @default(0) @db.Decimal(18, 3)
  netRevenue     Decimal @default(0) @db.Decimal(18, 3)
  notes          String?
  journalEntryId String?
  status         String  @default("OPEN")

  vehicle          CarWashVehicle     @relation(fields: [vehicleId], references: [id], onDelete: Restrict)
  location         CarWashLocation    @relation(fields: [locationId], references: [id], onDelete: Restrict)
  revenues         CarWashRevenue[]
  expenses         CarWashExpense[]
  knetTransactions KnetTransaction[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([vehicleId, date])
  @@index([vehicleId])
  @@index([locationId])
  @@index([companyId])
  @@index([date])
  @@index([status])
  @@map("car_wash_daily_operations")
}

model CarWashRevenue {
  id          String      @id @default(cuid())
  operationId String
  type        RevenueType
  amount      Decimal     @db.Decimal(18, 3)
  description String?

  operation CarWashDailyOperation @relation(fields: [operationId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([operationId])
  @@map("car_wash_revenues")
}

enum RevenueType {
  CASH
  KNET
}

model CarWashExpense {
  id          String  @id @default(cuid())
  operationId String
  categoryId  String?
  amount      Decimal @db.Decimal(18, 3)
  description String

  operation CarWashDailyOperation @relation(fields: [operationId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([operationId])
  @@map("car_wash_expenses")
}

model KnetTransaction {
  id             String  @id @default(cuid())
  operationId    String
  amount         Decimal @db.Decimal(18, 3)
  transactionRef String?
  date           DateTime
  settlementId   String?
  isSettled      Boolean @default(false)

  operation  CarWashDailyOperation @relation(fields: [operationId], references: [id], onDelete: Restrict)
  settlement KnetSettlement?       @relation(fields: [settlementId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())

  @@index([operationId])
  @@index([settlementId])
  @@index([isSettled])
  @@index([date])
  @@map("knet_transactions")
}

model KnetSettlement {
  id             String   @id @default(cuid())
  companyId      String
  bankAccountId  String
  settlementDate DateTime
  grossAmount    Decimal  @db.Decimal(18, 3)
  commission     Decimal  @db.Decimal(18, 3)
  netAmount      Decimal  @db.Decimal(18, 3)
  journalEntryId String?
  notes          String?

