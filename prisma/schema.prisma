}

model AssetCustody {
  id                   String                    @id @default(cuid())
  companyId            String
  branchId             String?
  clientGeneratedId    String?
  assetItemId          String
  assignmentTargetType AssetAssignmentTargetType
  assignmentTargetId   String
  employeeId           String?
  driverId             String?
  vehicleId            String?
  carWashVehicleId     String?
  assignedDate         DateTime
  returnedDate         DateTime?
  conditionOnAssign    AssetCondition?
  conditionOnReturn    AssetCondition?
  assignedById         String
  returnedToId         String?
  status               AssetCustodyStatus       @default(ACTIVE)
  notes                String?

  company        Company         @relation(fields: [companyId], references: [id], onDelete: Restrict)
  branch         Branch?         @relation(fields: [branchId], references: [id], onDelete: Restrict)
  assetItem      AssetItem       @relation(fields: [assetItemId], references: [id], onDelete: Restrict)
  assignedBy     User            @relation("AssetCustodyAssignedBy", fields: [assignedById], references: [id], onDelete: Restrict)
  returnedTo     User?           @relation("AssetCustodyReturnedBy", fields: [returnedToId], references: [id], onDelete: Restrict)
  employee       Employee?       @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  driver         Driver?         @relation(fields: [driverId], references: [id], onDelete: Restrict)
  vehicle        Vehicle?        @relation("AssetCustodyVehicle", fields: [vehicleId], references: [id], onDelete: Restrict)
  carWashVehicle CarWashVehicle? @relation("AssetCustodyCarWashVehicle", fields: [carWashVehicleId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([companyId, clientGeneratedId])
  @@index([companyId])
  @@index([branchId])
  @@index([assetItemId])
  @@index([assignmentTargetType, assignmentTargetId])
  @@index([employeeId])
  @@index([driverId])
  @@index([vehicleId])
  @@index([carWashVehicleId])
  @@index([status])
  @@index([assignedDate])
  @@map("asset_custodies")
}

