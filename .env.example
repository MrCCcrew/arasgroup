# ─────────────────────────────────────────────
# Database (MySQL)
# ─────────────────────────────────────────────
DATABASE_URL="mysql://USER:PASSWORD@localhost:3306/rashidgroup_db"

# ─────────────────────────────────────────────
# Auth
# ─────────────────────────────────────────────
JWT_SECRET="change-this-to-a-random-32-char-string"
JWT_EXPIRES_IN="7d"

# ─────────────────────────────────────────────
# App
# ─────────────────────────────────────────────
NODE_ENV="production"
NEXT_PUBLIC_APP_URL="https://arasgroup.app"
NEXT_PUBLIC_APP_NAME="نظام مجموعة رشيد"

# ─────────────────────────────────────────────
# Cloudflare R2 Storage
# ─────────────────────────────────────────────
R2_ACCOUNT_ID="your-cloudflare-account-id"
R2_ACCESS_KEY_ID="your-r2-access-key-id"
R2_SECRET_ACCESS_KEY="your-r2-secret-access-key"
R2_BUCKET_NAME="rashidgroup"
R2_PUBLIC_URL="https://pub-xxxx.r2.dev"
